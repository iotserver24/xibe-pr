# Environment variables for the PR Site
# Copy this file to .env and update the values

# Bot API URL (where your bot is hosted)
VITE_BOT_URL=https://your-bot-domain.com

# Site URL (where this site is hosted)
VITE_SITE_URL=https://your-site-domain.com

# GitHub App Installation URL (optional, for direct installation)
VITE_GITHUB_APP_URL=https://github.com/apps/your-app-name/installations/new