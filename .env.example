# ============================================
# XIbe PR Review Bot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# AI Configuration (Required)
# ============================================
# Use OpenAI-compatible API (e.g., OpenAI, MegaLLM, etc.)
AI_API=https://api.openai.com/v1
AI_KEY=your_ai_api_key_here

# Two-Stage AI Models Configuration
# Stage 1 (Agent 1): Individual File Analysis - focuses on security & hardcoded values
ANALYSIS_MODEL=gpt-4

# Stage 2 (Agent 2): Review Synthesis - creates comprehensive final review
COMMENT_MODEL=gpt-4

# Legacy Model (for backward compatibility)
MODEL_ID=gpt-4

# ============================================
# GitHub Configuration (Required)
# ============================================
# Choose ONE authentication method:

# --- Option A: GitHub App (Recommended) ---
# Creates professional bot account with [bot] badge
# 1. Create a GitHub App at: https://github.com/settings/apps/new
# 2. Set permissions: Contents (Read), Issues (Read/Write), Pull requests (Read/Write)
# 3. Subscribe to events: Issue comments, Pull requests
# 4. Generate a private key and convert to base64

GITHUB_APP_ID=your_github_app_id

# IMPORTANT: For Docker/production deployments, use base64-encoded key
# To encode your private key, run:
#   node -e "console.log(require('fs').readFileSync('your-key.pem').toString('base64'))"
# Or use the included script:
#   node scripts/encode-private-key.js your-key.pem
GITHUB_PRIVATE_KEY_BASE64=your_base64_encoded_private_key_here

# Alternative: Raw PEM key (for local development only, may cause issues in Docker)
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Option B: Personal Access Token (Simpler, but less professional) ---
# For personal use only - comments appear from your account
# 1. Go to: https://github.com/settings/tokens
# 2. Create token with: repo, write:discussion scopes
# GITHUB_TOKEN=ghp_your_personal_access_token_here

# Webhook secret (generate a random 32+ character string)
WEBHOOK_SECRET=your_webhook_secret_here

# GitHub OAuth (optional - for frontend login)
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/auth/github/callback

# ============================================
# Bot Configuration
# ============================================
BOT_USERNAME=Xibe-review
PORT=3000
AUTO_REVIEW_ENABLED=true

# Admin key for protected dashboard endpoints
ADMIN_KEY=your_admin_key_here

# ============================================
# Database Configuration (Required)
# ============================================
# MongoDB connection string for analytics and logging
MONGODB_URI=mongodb://localhost:27017/xibe-pr1

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
SESSION_SECRET=your_session_secret_here
FRONTEND_URL=https://your-domain.com

# ============================================
# Optional: E2B Agent Mode (Advanced)
# ============================================
# Enables code execution in sandbox for deeper analysis
E2B_ENABLED=false
E2B_API_KEY=your_e2b_api_key_here
E2B_TIMEOUT=300000

# ============================================
# Available AI Models Reference
# ============================================
# OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# MegaLLM: gemini-3-pro-preview, deepseek, qwen-coder, mistral
# 
# For ANALYSIS_MODEL (code analysis):
#   - gpt-4 (best quality)
#   - deepseek (excellent reasoning)
#   - qwen-coder (code-specialized)
#
# For COMMENT_MODEL (review synthesis):
#   - gpt-4 (most capable)
#   - gpt-4-turbo (faster)
#   - mistral (balanced)